{
  "name": "@ledgerflow/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./migrations": "./drizzle/migrations.js"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ledgerflow/core": "workspace:*",
    "drizzle-orm": "0.45.4"
  },
  "peerDependencies": {
    "expo-sqlite": ">=14"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "expo-sqlite": "58.0.13",
    "vitest": "5.0.5",
    "@ledgerflow/config": "workspace:*"
  }
}
